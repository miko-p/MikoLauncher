{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MikoLauncher",
  "version": "0.1.0",
  "identifier": "dev.mikolauncher.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @miko-launcher/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @miko-launcher/desktop build",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MikoLauncher",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
