{
  "name": "miko-launcher",
  "version": "0.1.0",
  "description": "MikoLauncher — Minecraft Java 版启动器：Cordis 插件范式 + 前后端分离 + Tauri/Rust 内核",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build:shared": "pnpm --filter @miko-launcher/shared build",
    "dev:host": "pnpm --filter @miko-launcher/plugin-host dev",
    "dev:desktop": "pnpm --filter @miko-launcher/desktop tauri dev",
    "build": "pnpm -r build"
  }
}
